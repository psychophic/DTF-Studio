_SHIRT_STYLE = {  # fill, outline, collar/seams
    "white": ((244, 244, 247, 255), (176, 176, 186, 255), (205, 205, 214, 255)),
    "black": ((24, 24, 27, 255), (78, 78, 88, 255), (52, 52, 60, 255)),
    "outline": ((0, 0, 0, 0), (214, 214, 226, 255), (160, 160, 172, 255)),
}
