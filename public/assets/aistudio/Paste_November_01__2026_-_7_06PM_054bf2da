                      text_color=TXT, command=self.open_out).pack(fill="x", padx=14, pady=(10, 0))

        # ------- log
        self.log = ctk.CTkTextbox(self, height=170, fg_color=CARD, text_color=MUTED, font=("Consolas", 11))
        self.log.grid(row=1, column=0, sticky="nsew", padx=(16, 0), pady=(0, 16))
        self.log.configure(state="disabled")
        self._summary()

    # ---- file list
    def _refresh_list(self):
        self.listbox.delete(0, "end")
        for path, rel in self.items:
            self.listbox.insert("end", os.path.basename(path) + (f"      [{rel}]" if rel else ""))
        self.count.configure(text=f"{len(self.items)} image{'s' if len(self.items) != 1 else ''}")

    def _add(self, entries):
        have = {p for p, _ in self.items}
        for path, rel in entries:
            if path not in have and path.lower().endswith(self.EXTS):
                self.items.append((path, rel))
                have.add(path)
        self._refresh_list()

    def add_files(self):
        files = filedialog.askopenfilenames(parent=self, title="Select images", filetypes=[
            ("Images", "*.png *.jpg *.jpeg *.webp *.bmp *.tif *.tiff"), ("All files", "*.*")])
        self._add([(f, "") for f in files])

    def add_folder(self):
        base = filedialog.askdirectory(parent=self, title="Select a folder of images")
        if not base:
            return
        found = []
        if self.sub.get():
            for root, _, files in os.walk(base):
                rel = os.path.relpath(root, base)
                rel = "" if rel == "." else rel
                found += [(os.path.join(root, f), rel) for f in sorted(files)]
        else:
            found = [(os.path.join(base, f), "") for f in sorted(os.listdir(base))
                     if os.path.isfile(os.path.join(base, f))]
        before = len(self.items)
        self._add(found)
        if not self.out_var.get():
            self.out_var.set(os.path.join(base, "_dtf_output"))
        self.status.configure(text=f"Added {len(self.items) - before} images from the folder.")

    def remove_selected(self):
        for i in reversed(self.listbox.curselection()):
            self.items.pop(i)
        self._refresh_list()

    def clear_list(self):
        self.items = []
        self._refresh_list()

    def browse_out(self):
        d = filedialog.askdirectory(parent=self, title="Output folder")
        if d:
            self.out_var.set(d)

    def open_out(self):
        d = self.out_var.get().strip()
        if not d or not os.path.isdir(d):
            return
        try:
            if sys.platform.startswith("win"):
                os.startfile(d)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", d])
            else:
                subprocess.Popen(["xdg-open", d])
        except Exception:
            pass

    # ---- settings
    def settings(self):
        choice = self.settings_var.get()
        if choice == "Current settings":
            return self.app.params(), self.app.key_color
        data = {} if choice == "Default" else self.app.presets.get(choice, {})
        p = {k: d for k, (v, d) in self.app.vars.items()}
        p.update({k: v for k, v in data.items() if k != "_key"})
        kc = data.get("_key")
        return p, (tuple(kc) if kc else (0, 255, 0))

    def _summary(self):
        p, _ = self.settings()
        mode = p["mode"] + (f" ({p['shape']})" if p["mode"] == "Halftone" else "")
        size = p["size"] + (f" {p['custom']} px" if p["size"] == "Custom" else "")
        extra = []
        if p.get("mirror"):
            extra.append("mirrored")
        if p.get("ub"):
            extra.append("+ white underbase")
        self.summary.configure(text=f"{mode}  ·  remove: {p['target']}\nSize: {size}  ·  {p['dpi']} DPI"
                                    + ("  ·  " + ", ".join(extra) if extra else ""))

    # ---- run
    def run(self):
        if self.running:
            return
        if not self.items:
            self.status.configure(text="Add images or a folder first.")
            return
        out = self.out_var.get().strip()
        if not out:
            self.status.configure(text="Choose an output folder.")
            return
        try:
            os.makedirs(out, exist_ok=True)
        except OSError as e:
            self.status.configure(text=f"Cannot create output folder: {e}")
            return
        p, key = self.settings()
        suffix = self.suffix.get().replace("/", "_").replace("\\", "_")
        self.stop.clear()
        self.running = True
        self.btn_run.configure(state="disabled")
        self.btn_stop.configure(state="normal")
        self.progress.set(0)
        self.log.configure(state="normal")
        self.log.delete("1.0", "end")
        self.log.configure(state="disabled")
        threading.Thread(target=self._worker, daemon=True,
                         args=(list(self.items), p, key, out, suffix, self.policy.get(), self.keep.get())).start()

    @staticmethod
    def _dest(path, policy):
        if not os.path.exists(path):
            return path
        if policy == "Overwrite":
            return path
        if policy == "Skip":
            return None
        stem, ext = os.path.splitext(path)
        n = 1
        while os.path.exists(f"{stem}_{n}{ext}"):
            n += 1
        return f"{stem}_{n}{ext}"

    def _worker(self, items, p, key, out, suffix, policy, keep):
        ok = skip = fail = 0
        total = len(items)
        try:
            dpi = int(p["dpi"])
        except (ValueError, TypeError):
            dpi = 300
        for i, (path, rel) in enumerate(items, 1):
            if self.stop.is_set():
                break
            name = os.path.basename(path)
            self.q.put(("status", f"{i}/{total}  ·  {name}"))
            try:
                rgb, alpha = load_source(path)
                size, L = self.app.calc_out_for(rgb.size, p)
                folder = os.path.join(out, rel) if (keep and rel) else out
                os.makedirs(folder, exist_ok=True)
                dest = self._dest(os.path.join(folder, os.path.splitext(name)[0] + suffix + ".png"), policy)
                if dest is None:
                    skip += 1
                    self.q.put(("log", f"SKIP   {name}  (already exists)"))
                else:
                    img = render(rgb, alpha, size, 1.0, p, key, fit_long=L)
                    img.save(dest, "PNG", dpi=(dpi, dpi))
                    if p.get("ub"):
                        ub = os.path.splitext(dest)[0] + "_underbase.png"
                        make_underbase(img, p["ubchoke"]).save(ub, "PNG", dpi=(dpi, dpi))
                    ok += 1
                    self.q.put(("log", f"OK     {name}  →  {os.path.basename(dest)}  ({img.size[0]} × {img.size[1]})"))
                    del img
                del rgb, alpha
            except Exception as e:
                fail += 1
                self.q.put(("log", f"FAIL   {name}  ({e})"))
            gc.collect()
            self.q.put(("progress", i / total))
        self.q.put(("done", (ok, skip, fail, self.stop.is_set())))

    def _poll(self):
        try:
            while True:
                kind, data = self.q.get_nowait()
                if kind == "status":
                    self.status.configure(text=data)
                elif kind == "progress":
                    self.progress.set(data)
                elif kind == "log":
                    self.log.configure(state="normal")
                    self.log.insert("end", data + "\n")
                    self.log.see("end")
                    self.log.configure(state="disabled")
                elif kind == "done":
                    ok, skip, fail, stopped = data
                    self.running = False
                    self.btn_run.configure(state="normal")
                    self.btn_stop.configure(state="disabled")
                    self.status.configure(text=("Stopped.  " if stopped else "Finished.  ")
                                               + f"{ok} saved, {skip} skipped, {fail} failed.")
        except queue.Empty:
            pass
        except Exception:
            return
        try:
            self.after(60, self._poll)
        except Exception:
            pass

    def _close(self):
        if self.running:
            if not messagebox.askyesno("Batch running", "Stop the batch and close this window?", parent=self):
                return
            self.stop.set()
        self.destroy()


