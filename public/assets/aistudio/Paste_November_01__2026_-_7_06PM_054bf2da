    # ---- units / sizes
    def _u(self, inches):
        return inches if self.unit == "in" else inches * 2.54

    def _inch(self, v):
        return v if self.unit == "in" else v / 2.54

    def _fill_form(self, s):
        self.f_name.set(s["name"])
        self.f_w.set(fmt_num(self._u(s["w"])))
        self.f_h.set(fmt_num(self._u(s["h"])))
        self.f_top.set(fmt_num(self._u(s.get("top", 3.0))))
        self.f_side.set(fmt_num(self._u(s.get("side", 3.0))))
        self.f_view.set(s.get("view", "Front"))
        self.f_place.set(s.get("place", "Center"))
        if s.get("paper") in PAPERS:
            self.paper.set(s["paper"])

    def spec(self):
        try:
            w = self._inch(float(self.f_w.get().replace(",", ".")))
            h = self._inch(float(self.f_h.get().replace(",", ".")))
            top = self._inch(float(self.f_top.get().replace(",", ".")))
            side = self._inch(float(self.f_side.get().replace(",", ".")))
        except ValueError:
            return None
        if w <= 0 or h <= 0:
            return None
        return dict(name=self.f_name.get().strip() or "Custom", w=w, h=h, view=self.f_view.get(),
                    place=self.f_place.get(), top=top, side=side)

    def _render_sizes(self):
        for w in self.size_list.winfo_children():
            w.destroy()
        for i, s in enumerate(self.sizes):
            act = i == self.sel
            txt = f"{s['name']}    {fmt_num(self._u(s['w']))} × {fmt_num(self._u(s['h']))} {self.unit}"
            ctk.CTkButton(self.size_list, text=txt, anchor="w", height=30, fg_color=ACC if act else CARD,
                          hover_color=ACC_H if act else "#26262c", text_color="#ffffff" if act else TXT,
                          command=lambda i=i: self.select(i)).pack(fill="x", pady=2)

    def select(self, i):
        if not (0 <= i < len(self.sizes)):
            return
        self.sel = i
        self._fill_form(self.sizes[i])
        self._render_sizes()
        self.schedule()

    def _unit_changed(self):
        sp = self.spec()
        self.unit = self.unit_var.get()
        save_sizes(self.unit, self.sizes)
        if sp:
            self._fill_form(sp)
        self._render_sizes()
        self.schedule()

    def save_size(self):
        sp = self.spec()
        if sp is None or not self.f_name.get().strip():
            self.status.configure(text="Enter a name and valid numbers first.", text_color="#e0b050")
            return
        sp["paper"] = self.paper.get()
        for i, s in enumerate(self.sizes):
            if s["name"].lower() == sp["name"].lower():
                self.sizes[i] = sp
                self.sel = i
                break
        else:
            self.sizes.append(sp)
            self.sel = len(self.sizes) - 1
        save_sizes(self.unit, self.sizes)
        self._render_sizes()
        self.status.configure(text=f"Size saved: {sp['name']}", text_color=MUTED)

    def delete_size(self):
        if not (0 <= self.sel < len(self.sizes)):
            return
        name = self.sizes[self.sel]["name"]
        if not messagebox.askyesno("Delete size", f"Delete size '{name}'?", parent=self):
            return
        self.sizes.pop(self.sel)
        save_sizes(self.unit, self.sizes)
        self.sel = min(self.sel, len(self.sizes) - 1)
        self._render_sizes()
        if self.sizes:
            self.select(self.sel)

    def reset_sizes(self):
        if not messagebox.askyesno("Reset sizes", "Restore the original size list?", parent=self):
            return
        self.sizes = default_sizes()
        save_sizes(self.unit, self.sizes)
        self.select(0)

    # ---- preview
    def schedule(self, *_):
        if self._pv:
            self.after_cancel(self._pv)
        self._pv = self.after(120, self.draw_preview)

    def draw_preview(self):
        self._pv = None
        c = self.canvas
        cw, ch = c.winfo_width(), c.winfo_height()
        if cw < 80 or ch < 80:
            return
        c.delete("all")
        sp = self.spec()
        if sp is None:
            c.create_text(cw / 2, ch / 2, text="Enter valid numbers for the size fields", fill=MUTED)
            self.info.configure(text="")
            return
        try:
            dpi = int(self.dpi.get())
        except ValueError:
            dpi = 300
        body = SHIRT_BODY_IN.get(self.shirt_size.get(), 20)
        W_in = body / 0.72
        back = sp["view"] == "Back"
        place = sp["place"]
        sleeve = place in ("Left sleeve", "Right sleeve")
        shirt = get_shirt(self.kind.get().lower(), back)
        H_in = W_in * shirt.height / shirt.width
        s = min(cw * 0.9 / W_in, ch * 0.9 / H_in)           # preview pixels per inch
        sw, sh = max(1, round(W_in * s)), max(1, round(H_in * s))
        sx, sy = (cw - sw) // 2, (ch - sh) // 2
        stage = Image.new("RGB", (cw, ch), self.STAGE)
        shimg = shirt.resize((sw, sh), Image.LANCZOS)
        stage.paste(shimg.convert("RGB"), (sx, sy), shimg.getchannel("A"))

        box = (max(4, round(sp["w"] * s)), max(4, round(sp["h"] * s)))
        design = render_for_box(self.app.proxy, self.app.proxy_alpha, box, self.p, self.key,
                                mirror=False, k=s / dpi)
        collar_y = sy + (self.collar.get() / 100.0) * (0.34 if back else 1.0) * sh
        mid = sx + sw / 2
        corners = None
        if sleeve:
            left = place == "Left sleeve"                   # wearer's left = viewer's right
            hem = (sx + (92.5 if left else 7.5) / 100.0 * sw, sy + 30.5 / 104.0 * sh)
            phi = math.radians(-28.3 if left else 28.3)     # clockwise tilt of the sleeve axis
            n = (math.sin(phi), -math.cos(phi))
            dist = sp["top"] * s + design.height / 2
            cxs, cys = hem[0] + n[0] * dist, hem[1] + n[1] * dist
            rot = design.rotate(-math.degrees(phi), expand=True, resample=Image.BICUBIC)
            stage.paste(rot.convert("RGB"), (round(cxs - rot.width / 2), round(cys - rot.height / 2)),
                        rot.getchannel("A"))
            hw, hh = sp["w"] * s / 2, sp["h"] * s / 2
            corners = [(cxs + x * math.cos(phi) - y * math.sin(phi), cys + x * math.sin(phi) + y * math.cos(phi))
                       for x, y in ((-hw, -hh), (hw, -hh), (hw, hh), (-hw, hh))]
        else:
            if back or place == "Center":
                xoff = 0.0
            elif place == "Left chest":                      # wearer's left = viewer's right (front view)
                xoff = sp["side"] + sp["w"] / 2
            else:
                xoff = -(sp["side"] + sp["w"] / 2)
            cx = mid + xoff * s
            top = collar_y + sp["top"] * s
            stage.paste(design.convert("RGB"), (round(cx - design.width / 2), round(top)), design.getchannel("A"))

        self._tk = ImageTk.PhotoImage(stage)
        c.create_image(0, 0, anchor="nw", image=self._tk)
        c.create_line(mid, sy, mid, sy + sh, fill="#6b6b78", dash=(2, 4))
        lw, lh = f"{fmt_num(self._u(sp['w']))} {self.unit}", f"{fmt_num(self._u(sp['h']))} {self.unit}"
        fnt = ("Segoe UI", 10, "bold")
        if sleeve:
            pts = [v for pt in corners for v in pt]
            c.create_polygon(pts, outline=ACC_H, fill="", dash=(5, 4))
            c.create_text(cxs, max(corners[2][1], corners[3][1]) + 12, text=f"{lw} × {lh}", fill=ACC_H, font=fnt)
        else:
            bx0, bx1 = cx - sp["w"] * s / 2, cx + sp["w"] * s / 2
            by0, by1 = top, top + sp["h"] * s
            c.create_rectangle(bx0, by0, bx1, by1, outline=ACC_H, dash=(5, 4))
            c.create_text((bx0 + bx1) / 2, by1 + 12, fill=ACC_H, font=fnt, text=lw)
            c.create_text(min(cw - 40, bx1 + 8), (by0 + by1) / 2, anchor="w", fill=ACC_H, font=fnt, text=lh)
            # collar -> design ruler (like the placement guide)
            c.create_line(mid, collar_y, mid, top, fill=ACC_H, width=2)
            c.create_line(mid - 6, collar_y, mid + 6, collar_y, fill=ACC_H, width=2)
            c.create_line(mid - 6, top, mid + 6, top, fill=ACC_H, width=2)
            c.create_text(mid + 9, (collar_y + top) / 2, anchor="w", fill=ACC_H, font=fnt,
                          text=f"{fmt_num(self._u(sp['top']))} {self.unit}")

        dw_in, dh_in = design.width / s, design.height / s
        warn = []
        if not sleeve:
            if dw_in > body * 0.98:
                warn.append("wider than the shirt body")
            if top + design.height > sy + sh * 0.98:
                warn.append("extends past the hem")
        paper = PAPERS.get(self.paper.get())
        if paper is not None:
            pname = self.paper.get().split(" (")[0]
            if paper[0] == "roll":
                if dw_in > paper[1] - 0.5:
                    warn.append(f"is wider than {pname}")
            else:
                pw, ph = paper
                fits = (dw_in <= pw - 0.2 and dh_in <= ph - 0.45) or (dw_in <= ph - 0.2 and dh_in <= pw - 0.45)
                if not fits:
                    warn.append(f"does not fit on {pname}")
        line = (f"{sp['name']}  ·  design {fmt_num(self._u(dw_in))} × {fmt_num(self._u(dh_in))} {self.unit}"
                f" inside {lw} × {lh}  ·  {round(dw_in * dpi)} × {round(dh_in * dpi)} px @ {dpi} DPI")
        self.info.configure(text=line + ("\nWarning: design " + "; ".join(warn) if warn else "\nFits the shirt and the paper"),
                            text_color="#e0b050" if warn else MUTED)

    # ---- printing
    def printer_settings(self):
        name = self.printer.get()
        if name == "System default":
            name = self.default_printer
        if name:
            try:
                subprocess.Popen(["rundll32", "printui.dll,PrintUIEntry", "/e", "/n", name])
            except Exception as e:
                self.status.configure(text=str(e), text_color="#e07a7a")

    def _opts(self):
        sp = self.spec()
        if sp is None:
            self.status.configure(text="Check the size fields.", text_color="#e0b050")
            return None
        try:
            dpi = int(self.dpi.get())
            copies = max(1, int(self.copies.get()))
        except ValueError:
            self.status.configure(text="Copies must be a number.", text_color="#e0b050")
            return None
        return sp, dpi, copies, PAPERS.get(self.paper.get()), self.printer.get(), self.mirror.get()

    def print_now(self):
        o = self._opts()
        if o is None or self.busy:
            return
        sp, dpi, copies, paper, printer, mirror = o
        msg = (f"Print '{sp['name']}'  ({fmt_num(self._u(sp['w']))} × {fmt_num(self._u(sp['h']))} {self.unit})\n"
               f"Paper: {self.paper.get()}   ·   {dpi} DPI   ·   Copies: {copies}\n"
               f"Printer: {printer}\nMirrored: {'yes' if mirror else 'no'}")
        if messagebox.askyesno("Print", msg, parent=self):
            self._start(o, None)

    def save_file(self):
        o = self._opts()
        if o is None or self.busy:
            return
        base = os.path.splitext(os.path.basename(self.app.src_path or "design"))[0]
        nm = "".join(ch if ch.isalnum() or ch in "-_" else "_" for ch in o[0]["name"])
        path = filedialog.asksaveasfilename(parent=self, defaultextension=".pdf", initialfile=f"{base}_{nm}.pdf",
                                            filetypes=[("PDF (exact physical size)", "*.pdf"), ("PNG", "*.png")])
        if path:
            self._start(o, path)

    def _start(self, o, save_path):
        self.busy = True
        self.btn_print.configure(state="disabled")
        self.btn_save.configure(state="disabled")
        self.progress.pack(fill="x")
        self.progress.start()
        self.status.configure(text="Rendering at print resolution…", text_color=MUTED)
        threading.Thread(target=self._worker, args=(o, save_path), daemon=True).start()

    def _worker(self, o, save_path):
        sp, dpi, copies, paper, printer, mirror = o
        try:
            sheet, _ = build_sheet(self.app.src, self.app.src_alpha, self.p, self.key, sp["w"], sp["h"],
                                   paper, dpi, mirror)
            if save_path:
                save_sheet(sheet, save_path, dpi)
                msg = f"Saved {os.path.basename(save_path)}  ({sheet.size[0]} × {sheet.size[1]} px @ {dpi} DPI)"
            else:
                self.q.put(("msg", "Sending to printer…"))
                msg = send_to_printer(sheet, dpi, printer, copies)
            self.q.put(("ok", msg))
        except Exception as e:
            self.q.put(("err", str(e)))
        self.q.put(("end", None))

    def _poll(self):
        try:
            while True:
                kind, data = self.q.get_nowait()
                if kind == "msg":
                    self.status.configure(text=data, text_color=MUTED)
                elif kind == "ok":
                    self.status.configure(text=data, text_color="#7bd88f")
                elif kind == "err":
                    self.status.configure(text=f"Error: {data}", text_color="#e07a7a")
                elif kind == "end":
                    self.busy = False
                    self.progress.stop()
                    self.progress.pack_forget()
                    self.btn_print.configure(state="normal")
                    self.btn_save.configure(state="normal")
        except queue.Empty:
            pass
        except Exception:
            return
        try:
            self.after(60, self._poll)
        except Exception:
            pass


