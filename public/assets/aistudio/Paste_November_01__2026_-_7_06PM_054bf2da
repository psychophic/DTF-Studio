def load_logo(width):
    """Logo from 'logo.png' next to this script (if present), otherwise the embedded one."""
    try:
        fp = os.path.join(os.path.dirname(os.path.abspath(__file__)), "logo.png")
        if os.path.isfile(fp):
            im = Image.open(fp)
        else:
            im = Image.open(io.BytesIO(base64.b64decode(LOGO_B64)))
        im = im.convert("RGBA")
        bb = im.getchannel("A").getbbox()
        if bb:
            im = im.crop(bb)
        h = round(width * im.height / im.width)
        return ctk.CTkImage(light_image=im, dark_image=im, size=(width, h))
    except Exception:
        return None



class Viewer(tk.Canvas):
    def __init__(self, master):
        super().__init__(master, bg=BG, highlightthickness=0, bd=0)
        self.img = None
        self._tk = None
        self.zoom, self.ox, self.oy = 1.0, 0.0, 0.0
        self.on_click = None
        self.on_zoom = None
        self._drag = None
        self._moved = False
        self.bind("<Configure>", lambda e: self.redraw())
        self.bind("<ButtonPress-1>", self._press)
        self.bind("<B1-Motion>", self._motion)
        self.bind("<ButtonRelease-1>", self._release)
        self.bind("<MouseWheel>", self._wheel)
        self.bind("<Button-4>", self._wheel)
        self.bind("<Button-5>", self._wheel)
        self.bind("<Double-Button-1>", lambda e: self.fit())

    def set_image(self, img, refit=False):
        changed = self.img is None or self.img.size != img.size
        self.img = img
        if changed or refit:
            self.fit()
        else:
            self.redraw()

    def clear(self):
        self.img = None
        self._tk = None
        self.delete("img")

    def fit(self):
        if self.img is None:
            return
        cw, ch = max(self.winfo_width(), 50), max(self.winfo_height(), 50)
        iw, ih = self.img.size
        self.zoom = min(cw / iw, ch / ih) * 0.96
        self.ox, self.oy = (cw - iw * self.zoom) / 2, (ch - ih * self.zoom) / 2
        self.redraw()

    def redraw(self):
        self.delete("img")
        if self.img is None:
            return
        cw, ch = self.winfo_width(), self.winfo_height()
        iw, ih = self.img.size
        z = self.zoom
        x0 = max(0, int(math.floor(-self.ox / z)))
        y0 = max(0, int(math.floor(-self.oy / z)))
        x1 = min(iw, int(math.ceil((cw - self.ox) / z)))
        y1 = min(ih, int(math.ceil((ch - self.oy) / z)))
        if x1 > x0 and y1 > y0:
            crop = self.img.crop((x0, y0, x1, y1))
            w, h = max(1, round((x1 - x0) * z)), max(1, round((y1 - y0) * z))
            res = Image.NEAREST if z >= 3 else (Image.BILINEAR if z >= 1 else Image.LANCZOS)
            self._tk = ImageTk.PhotoImage(crop.resize((w, h), res))
            self.create_image(self.ox + x0 * z, self.oy + y0 * z, anchor="nw", image=self._tk, tags="img")
        if self.on_zoom:
            self.on_zoom(z)

    def _wheel(self, e):
        if self.img is None:
            return
        if getattr(e, "num", 0) == 4:
            f = 1.15
        elif getattr(e, "num", 0) == 5:
            f = 1 / 1.15
        else:
            f = 1.15 if e.delta > 0 else 1 / 1.15
        nz = min(max(self.zoom * f, 0.02), 20)
        f = nz / self.zoom
        self.ox = e.x - (e.x - self.ox) * f
        self.oy = e.y - (e.y - self.oy) * f
        self.zoom = nz
        self.redraw()

    def _press(self, e):
        self._drag = (e.x, e.y, self.ox, self.oy)
        self._moved = False

    def _motion(self, e):
        if not self._drag:
            return
        dx, dy = e.x - self._drag[0], e.y - self._drag[1]
        if abs(dx) > 3 or abs(dy) > 3:
            self._moved = True
        if self._moved:
            self.ox, self.oy = self._drag[2] + dx, self._drag[3] + dy
            self.redraw()

    def _release(self, e):
        if self._drag and not self._moved and self.on_click and self.img is not None:
            ix, iy = (e.x - self.ox) / self.zoom, (e.y - self.oy) / self.zoom
            if 0 <= ix < self.img.size[0] and 0 <= iy < self.img.size[1]:
                self.on_click(int(ix), int(iy))
        self._drag = None


