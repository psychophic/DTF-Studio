    # ---- widget helpers
    def _section(self, parent, text):
        ctk.CTkLabel(parent, text=text.upper(), font=("Segoe UI", 10, "bold"), text_color=MUTED,
                     anchor="w").pack(fill="x", pady=(16, 2), padx=4)

    def _fixed_seg(self, parent, var, values, cmd, width, padx=0):
        """Segmented button inside a fixed-size holder: width/height never change."""
        holder = ctk.CTkFrame(parent, width=width, height=30, fg_color="transparent")
        holder.pack_propagate(False)
        holder.pack(side="right", padx=padx)
        s = ctk.CTkSegmentedButton(holder, values=values, variable=var, command=lambda v: cmd(),
                                   selected_color=ACC, selected_hover_color=ACC_H, unselected_color=CARD,
                                   unselected_hover_color="#26262c", fg_color=CARD, text_color=TXT, height=28)
        s.pack(fill="both", expand=True)
        return s

    def _seg(self, parent, var, values, cmd=None, pack="top", padx=0):
        s = ctk.CTkSegmentedButton(parent, values=values, variable=var, command=(lambda v: cmd()) if cmd else None,
                                   selected_color=ACC, selected_hover_color=ACC_H, unselected_color=CARD,
                                   unselected_hover_color="#26262c", fg_color=CARD, text_color=TXT, height=28)
        if pack == "top":
            s.pack(fill="x", pady=(6, 0), padx=2)
        else:
            s.pack(side=pack, padx=padx)
        return s

    HT_KEYS = {"shape", "dot", "angle", "gain", "mindot", "ink", "flat"}

    def _reg(self, key, var, default, live=True):
        self.vars[key] = (var, default)
        if key in self.HT_KEYS:
            var.trace_add("write", self._auto_ht)
        if key != "prevsz":
            var.trace_add("write", self._mark_dirty)
        if live:
            var.trace_add("write", self.schedule)

    def slider(self, parent, key, label, lo, hi, default, fmt="{:.0f}", steps=None, live=True):
        var = ctk.DoubleVar(value=default)
        self._reg(key, var, default, live)
        row = ctk.CTkFrame(parent, fg_color="transparent")
        row.pack(fill="x", pady=(8, 0), padx=4)
        ctk.CTkLabel(row, text=label, text_color=TXT, anchor="w").pack(side="left")
        val = ctk.CTkLabel(row, text=fmt.format(default), text_color=MUTED)
        val.pack(side="right")
        ctk.CTkSlider(parent, from_=lo, to=hi, variable=var, number_of_steps=steps, height=14,
                      progress_color=ACC, button_color=ACC, button_hover_color=ACC_H,
                      fg_color="#2a2a31").pack(fill="x", padx=4, pady=(2, 0))
        var.trace_add("write", lambda *a: val.configure(text=fmt.format(var.get())))

    def segment(self, parent, key, values, default, live=True):
        var = ctk.StringVar(value=default)
        self._reg(key, var, default, live)
        self._seg(parent, var, values)
        return var

