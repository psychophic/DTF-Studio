    def params(self):
        p = {k: v.get() for k, (v, d) in self.vars.items()}
        return p

    def _mode_changed(self, *_):
        if self._resetting:
            return
        if self.vars["mode"][0].get() == "Halftone":
            try:
                self.tabs.set("Halftone")
            except Exception:
                pass

    def _auto_ht(self, *_):
        if self._resetting:
            return
        v = self.vars["mode"][0]
        if v.get() != "Halftone":
            v.set("Halftone")

    def reset(self):
        """Back to the state right after importing the image."""
        self.apply_settings({}, run=False)
        self.active_preset, self.preset_dirty = "Default", False
        self._render_presets()
        self.picking = False
        self.viewer.configure(cursor="arrow")
        self.bg_var.set("Checker")
        self.view_var.set("Result")
        try:
            self.tabs.set("Remove")
        except Exception:
            pass
        self._refit = True
        self._update_info()
        self.schedule()

    def clear(self):
        """Remove the image and get ready for the next one."""
        if self._after:
            self.after_cancel(self._after)
            self._after = None
        self.src = self.src_alpha = self.proxy = self.proxy_alpha = None
        self.src_path = None
        self.result = None
        self.src_size = (1, 1)
        self.viewer.clear()
        self.zoom_lbl.configure(text="")
        self.lbl_file.configure(text="No image loaded")
        self.lbl_info.configure(text="")
        self.reset()
        self.status.configure(text="Open an image to begin  (Ctrl+O)")

    # ------------------------------------------------------- print / batch
    def calc_out_for(self, size, p):
        w, h = size
        m = max(w, h)
        L = self.SIZES.get(p["size"], None)
        if L == -1:
            try:
                L = int(float(p["custom"]))
            except (ValueError, TypeError):
                L = m
        if not L:
            L = m
        L = int(min(max(L, 64), 16000))
        r = L / m
        return (max(1, round(w * r)), max(1, round(h * r))), L

    def _open_child(self, attr, cls):
        win = getattr(self, attr, None)
        try:
            if win is not None and win.winfo_exists():
                win.lift()
                win.focus_force()
                return
        except Exception:
            pass
        setattr(self, attr, cls(self))

    def open_print(self):
        if self.src is None:
            messagebox.showinfo("Print", "Open an image first.")
            return
        self._open_child("_print_win", PrintWindow)

    def open_batch(self):
        self._open_child("_batch_win", BatchWindow)

    # ------------------------------------------------------------ presets
    PRESET_FILE = os.path.join(os.path.expanduser("~"), ".dtf_halftone_studio", "presets.json")

    def _load_presets(self):
        try:
            with open(self.PRESET_FILE, "r", encoding="utf-8") as fh:
                data = json.load(fh).get("presets", {})
            return {str(k): v for k, v in data.items() if isinstance(v, dict)}
        except Exception:
            return {}

    def _write_presets(self):
        try:
            os.makedirs(os.path.dirname(self.PRESET_FILE), exist_ok=True)
            with open(self.PRESET_FILE, "w", encoding="utf-8") as fh:
                json.dump({"presets": self.presets}, fh, indent=2, ensure_ascii=False)
        except OSError as e:
            self.status.configure(text=f"Could not write presets file: {e}")

    def _tab_presets(self, f):
        self.lbl_active = ctk.CTkLabel(f, text="", text_color=TXT, anchor="w", font=("Segoe UI", 12, "bold"))
        self.lbl_active.pack(fill="x", padx=4, pady=(8, 0))
        self._section(f, "Saved presets")
        self.preset_list = ctk.CTkFrame(f, fg_color="transparent")
        self.preset_list.pack(fill="x", padx=2)

        self._section(f, "Save current settings as")
        row = ctk.CTkFrame(f, fg_color="transparent")
        row.pack(fill="x", padx=4, pady=(6, 0))
        self.preset_name = ctk.StringVar()
        ent = ctk.CTkEntry(row, textvariable=self.preset_name, placeholder_text="Preset name", height=32,
                           fg_color=CARD, border_color="#2a2a31")
        ent.pack(side="left", fill="x", expand=True)
        ent.bind("<Return>", lambda e: self.save_preset())
        ctk.CTkButton(row, text="Save", width=64, height=32, fg_color=ACC, hover_color=ACC_H,
                      command=self.save_preset).pack(side="left", padx=(6, 0))
        ctk.CTkLabel(f, text="Same name = overwrite. Presets keep every setting (mode, removal, halftone, output).",
                     text_color=MUTED, font=("Segoe UI", 11), anchor="w", justify="left",
                     wraplength=330).pack(fill="x", padx=4, pady=(4, 0))

        self._section(f, "Reset")
        ctk.CTkButton(f, text="Reset to default settings", height=32, fg_color=CARD, hover_color="#26262c",
                      text_color=TXT, command=self.reset).pack(fill="x", padx=4, pady=(6, 0))
        ctk.CTkButton(f, text="Delete all saved presets", height=32, fg_color=CARD, hover_color="#3a2326",
                      text_color="#e07a7a", command=self.delete_all_presets).pack(fill="x", padx=4, pady=(6, 0))
        self._render_presets()

    def _render_presets(self):
        for w in self.preset_list.winfo_children():
            w.destroy()
        for n in ["Default"] + list(self.presets):
            row = ctk.CTkFrame(self.preset_list, fg_color="transparent")
            row.pack(fill="x", pady=2)
            act = n == self.active_preset
            ctk.CTkButton(row, text=n, anchor="w", height=32, fg_color=ACC if act else CARD,
                          hover_color=ACC_H if act else "#26262c", text_color="#ffffff" if act else TXT,
                          command=lambda n=n: self.apply_preset(n)).pack(side="left", fill="x", expand=True)
            if n != "Default":
                ctk.CTkButton(row, text="✕", width=32, height=32, fg_color=CARD, hover_color="#3a2326",
                              text_color=MUTED, command=lambda n=n: self.delete_preset(n)).pack(side="left", padx=(6, 0))
        self._update_active_label()

    def _update_active_label(self):
        if hasattr(self, "lbl_active"):
            self.lbl_active.configure(
                text=f"Active: {self.active_preset}" + ("  ·  modified" if self.preset_dirty else ""))

    def _mark_dirty(self, *_):
        if self._resetting or not hasattr(self, "lbl_active") or self.preset_dirty:
            return
        self.preset_dirty = True
        self._update_active_label()

    def apply_settings(self, data, run=True):
        """Apply a dict of settings; anything missing falls back to the factory default."""
        self._resetting = True
        for k, (v, d) in self.vars.items():
            if k == "prevsz":
                continue
            v.set(data.get(k, d))
        self._resetting = False
        kc = data.get("_key")
        self.key_color = tuple(kc) if kc else (0, 255, 0)
        self.swatch.configure(fg_color=self._hex(self.key_color))
        self._update_custom_state()
        if run:
            self._update_info()
            self.schedule()

    def apply_preset(self, name):
        data = {} if name == "Default" else self.presets.get(name)
        if data is None:
            return
        self.apply_settings(data)
        self.active_preset, self.preset_dirty = name, False
        self._render_presets()
        self.status.configure(text=f"Preset loaded: {name}")

    def save_preset(self):
        name = self.preset_name.get().strip()
        if not name:
            self.status.configure(text="Type a preset name first.")
            return
        if name.lower() == "default":
            messagebox.showinfo("Preset", "\"Default\" is reserved. Please choose another name.")
            return
        if name in self.presets and not messagebox.askyesno("Overwrite", f"Preset \"{name}\" already exists. Overwrite?"):
            return
        data = {k: v.get() for k, (v, d) in self.vars.items() if k != "prevsz"}
        data["_key"] = list(self.key_color)
        self.presets[name] = data
        self._write_presets()
        self.active_preset, self.preset_dirty = name, False
        self.preset_name.set("")
        self._render_presets()
        self.status.configure(text=f"Preset saved: {name}")

    def delete_preset(self, name):
        if not messagebox.askyesno("Delete preset", f"Delete preset \"{name}\"?"):
            return
        self.presets.pop(name, None)
        self._write_presets()
        if self.active_preset == name:
            self.active_preset = "Default"
        self._render_presets()

    def delete_all_presets(self):
        if not self.presets:
            return
        if not messagebox.askyesno("Delete all", "Delete ALL saved presets and return to default settings?"):
            return
        self.presets = {}
        self._write_presets()
        self.reset()

    def _update_custom_state(self):
        on = self.vars["size"][0].get() == "Custom"
        self.custom_entry.configure(state="normal" if on else "disabled",
                                    text_color=TXT if on else "#55555e")

    def _maximize(self):
        try:
            self.state("zoomed")
        except tk.TclError:
            try:
                self.attributes("-zoomed", True)
            except tk.TclError:
                self.geometry(f"{self.winfo_screenwidth()}x{self.winfo_screenheight()}+0+0")

    def _toggle_fs(self, *_):
        self._fs = not self._fs
        self.attributes("-fullscreen", self._fs)

    def _exit_fs(self, *_):
        if self._fs:
            self._fs = False
            self.attributes("-fullscreen", False)

    def calc_out(self, p):
        w, h = self.src_size
        m = max(w, h)
        L = self.SIZES.get(p["size"], None)
        if L == -1:
            try:
                L = int(float(p["custom"]))
            except ValueError:
                L = m
        if not L:
            L = m
        L = int(min(max(L, 64), 16000))
        r = L / m
        return (max(1, round(w * r)), max(1, round(h * r))), L

    def schedule(self, *_):
        if self.src is None:
            return
        self._update_info()
        if self._after:
            self.after_cancel(self._after)
        self._after = self.after(140, self.run_preview)

    def _update_info(self):
        if self.src is None:
            self.lbl_info.configure(text="")
            return
        try:
            p = self.params()
            (W, H), _ = self.calc_out(p)
            dpi = int(p["dpi"])
            self.lbl_info.configure(
                text=f"{W} × {H} px  ·  {W / dpi:.1f} × {H / dpi:.1f} in  ·  "
                     f"{W / dpi * 2.54:.1f} × {H / dpi * 2.54:.1f} cm @ {dpi} DPI")
        except Exception:
            pass

    # ------------------------------------------------------------- image IO
    def open_image(self):
        path = filedialog.askopenfilename(
            title="Open image",
            filetypes=[("Images", "*.png *.jpg *.jpeg *.webp *.bmp *.tif *.tiff"), ("All files", "*.*")])
        if not path:
            return
        try:
            im = ImageOps.exif_transpose(Image.open(path))
            alpha = None
            if im.mode in ("RGBA", "LA") or "transparency" in im.info:
                im = im.convert("RGBA")
                alpha = im.getchannel("A")
                if alpha.getextrema() == (255, 255):
                    alpha = None
            rgb = im.convert("RGB")
        except Exception as e:
            messagebox.showerror("Error", f"Cannot open image:\n{e}")
            return

        self.src, self.src_alpha = rgb, alpha
        self.src_size = rgb.size
        self.src_path = path
        prox = rgb.copy()
        prox.thumbnail((2560, 2560), Image.LANCZOS)
        self.proxy = prox
        if alpha is not None:
            pa = alpha.copy()
            pa.thumbnail((2560, 2560), Image.BILINEAR)
            self.proxy_alpha = pa
        else:
            self.proxy_alpha = None
        self.result = None
        self.view_var.set("Result")
        nm = os.path.basename(path)
        nm = nm if len(nm) <= 36 else nm[:33] + "…"
        self.lbl_file.configure(text=f"{nm}  ·  {rgb.size[0]} × {rgb.size[1]} px")
        self.viewer.img = None
        self._update_info()
        self.run_preview()

    # ------------------------------------------------------------- preview
    def run_preview(self):
        self._after = None
        if self.src is None:
            return
        if self.busy:
            self.dirty = True
            return
        self.busy, self.dirty = True, False
        self.status.configure(text="Processing…")
        threading.Thread(target=self._preview_worker, args=(self.params(), self.key_color), daemon=True).start()

    def _preview_worker(self, p, key):
        try:
            (W, H), L = self.calc_out(p)
            P = min(int(p["prevsz"]), L)
            m = max(self.src_size)
            size = (max(1, round(self.src_size[0] * P / m)), max(1, round(self.src_size[1] * P / m)))
            img = render(self.proxy, self.proxy_alpha, size, P / L, p, key)
            self.q.put(("preview", img))
        except Exception as e:
            self.q.put(("error", str(e)))
        self.q.put(("done", None))

    def _refresh_view(self, *_):
        rf, self._refit = self._refit, False
        if self.view_var.get() == "Original" and self.proxy is not None:
            self.viewer.set_image(self.proxy, rf)
        elif self.result is not None:
            self.viewer.set_image(composite(self.result, self.bg_var.get()), rf)

    # --------------------------------------------------------------- pick
    def start_pick(self):
        if self.proxy is None:
            return
        self.picking = True
        self.view_var.set("Original")
        self._refresh_view()
        self.viewer.configure(cursor="crosshair")
        self.status.configure(text="Click on the colour you want to remove…")

    def _on_click(self, x, y):
        if not self.picking or self.proxy is None:
            return
        x, y = min(x, self.proxy.size[0] - 1), min(y, self.proxy.size[1] - 1)
        self.key_color = self.proxy.getpixel((x, y))
        self.swatch.configure(fg_color=self._hex(self.key_color))
        self.picking = False
        self.viewer.configure(cursor="arrow")
        self.view_var.set("Result")
        self.vars["target"][0].set("Custom")
        self.run_preview()

    # --------------------------------------------------------------- export
    def export(self):
        if self.src is None or self.btn_export.cget("state") == "disabled":
            return
        base = os.path.splitext(os.path.basename(self.src_path))[0]
        path = filedialog.asksaveasfilename(defaultextension=".png", initialfile=f"{base}_dtf.png",
                                            filetypes=[("PNG", "*.png")])
        if not path:
            return
        self.btn_export.configure(state="disabled", text="Exporting…")
        self.progress.pack(fill="x", pady=(10, 0))
        self.progress.start()
        self.status.configure(text="Rendering full resolution…")
        threading.Thread(target=self._export_worker, args=(path, self.params(), self.key_color), daemon=True).start()

    def _export_worker(self, path, p, key):
        try:
            size, L = self.calc_out(p)
            # long side is guaranteed to equal the selected size (even with trim on)
            img = render(self.src, self.src_alpha, size, 1.0, p, key, fit_long=L)
            dpi = int(p["dpi"])
            img.save(path, "PNG", dpi=(dpi, dpi))
            extra = ""
            if p["ub"]:
                up = os.path.splitext(path)[0] + "_underbase.png"
                make_underbase(img, p["ubchoke"]).save(up, "PNG", dpi=(dpi, dpi))
                extra = f"  +  {os.path.basename(up)}"
            self.q.put(("exported", f"Saved {os.path.basename(path)}  ({img.size[0]} × {img.size[1]} px){extra}"))
        except Exception as e:
            self.q.put(("error", str(e)))
        self.q.put(("export_end", None))

    # ----------------------------------------------------------------- loop
    def _poll(self):
        try:
            while True:
                kind, data = self.q.get_nowait()
                if kind == "preview":
                    if self.src is None:
                        continue
                    self.result = data
                    self._refresh_view()
                    self.status.configure(text=f"Preview {data.size[0]} × {data.size[1]} px  ·  "
                                               f"scroll = zoom, drag = pan, double-click = fit")
                elif kind == "done":
                    self.busy = False
                    if self.dirty:
                        self.run_preview()
                elif kind == "exported":
                    self.status.configure(text=data)
                elif kind == "export_end":
                    self.progress.stop()
                    self.progress.pack_forget()
                    self.btn_export.configure(state="normal", text="Export Transparent PNG")
                elif kind == "error":
                    if self.src is not None:
                        self.status.configure(text=f"Error: {data}")
        except queue.Empty:
            pass
        self.after(50, self._poll)


class PrintWindow(ctk.CTkToplevel):
    STAGE = (42, 42, 48)
    PLACES = PLACEMENTS

    def __init__(self, app):
        super().__init__(app, fg_color=BG)
        self.app = app
        self.title("Print  ·  DTF Halftone Studio")
        self.geometry(f"{app.winfo_screenwidth()}x{app.winfo_screenheight() - 70}+0+0")
        self.minsize(1100, 720)
        self.after(250, lambda: maximize_window(self))
        self.unit, self.sizes = load_sizes()
        self.sel = 0
        self.q = queue.Queue()
        self.busy = False
        self._pv = None
        self._tk = None
        self.p = dict(app.params(), mirror=False)   # sublimation mirror is handled below
        self.key = app.key_color
        self.printers, self.default_printer = list_printers()
        self._build()
        self.select(0)
        self.after(150, self._grab)
        self.after(60, self._poll)

    def _grab(self):
        try:
            self.lift()
            self.focus_force()
            self.grab_set()
        except Exception:
            pass

