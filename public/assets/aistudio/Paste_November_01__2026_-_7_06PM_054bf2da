def _bezier(p0, c, p2, n=28):
    pts = []
    for i in range(n + 1):
        t = i / n
        pts.append(((1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * c[0] + t * t * p2[0],
                    (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * c[1] + t * t * p2[1]))
    return pts


def make_shirt(kind, back):
    """Procedurally drawn T-shirt (width 100 units = full width incl. sleeves, length 104 units)."""
    from PIL import ImageDraw
    fill, line, rib = _SHIRT_STYLE[kind]
    SS = 2
    W = 1040 * SS
    u = W / 100.0
    H = round(104 * u)
    depth = 4.5 if back else 13.0
    neck = _bezier((64, 1.5), (50, 2 * depth - 1.5), (36, 1.5))
    left = [(36, 1.5), (15, 8), (1, 27), (14, 34), (14, 104)]
    right = [(86, 104), (86, 34), (99, 27), (85, 8), (64, 1.5)]
    sp = [(x * u, y * u) for x, y in left + right + neck[1:-1]]
    img = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.polygon(sp, fill=fill)
    d.line(sp + [sp[0]], fill=line, width=9 if kind == "outline" else 6, joint="curve")
    d.line([(x * u, y * u) for x, y in neck], fill=rib, width=14, joint="curve")
    d.line([(15 * u, 8 * u), (14 * u, 34 * u)], fill=rib, width=5)
    d.line([(85 * u, 8 * u), (86 * u, 34 * u)], fill=rib, width=5)
    return img.resize((1040, round(H / SS)), Image.LANCZOS)


def _crop_shirt(im):
    im = ImageOps.exif_transpose(im).convert("RGBA")
    im.thumbnail((1600, 1600), Image.LANCZOS)
    w, h = im.size
    a = im.getchannel("A")
    bb = None
    if a.getextrema()[0] < 250:
        bb = a.getbbox()
    else:
        arr = np.asarray(im.convert("RGB")).astype(np.int16)
        corner = np.median(np.array([arr[0, 0], arr[0, -1], arr[-1, 0], arr[-1, -1]]), axis=0)
        mask = np.abs(arr - corner).max(axis=2) > 28
        ys, xs = np.where(mask)
        if len(xs):
            bb = (int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1)
    if bb is None or (bb[2] - bb[0]) < 0.3 * w or (bb[3] - bb[1]) < 0.3 * h:
        bb = (0, 0, w, h)
    return im.crop(bb)


def _user_shirt(kind, back):
    folder = os.path.join(os.path.dirname(os.path.abspath(__file__)), "shirts")
    for n in ([kind + "_back"] if back else []) + [kind]:
        for ext in (".png", ".jpg", ".jpeg", ".webp"):
            fp = os.path.join(folder, n + ext)
            if os.path.isfile(fp):
                try:
                    return _crop_shirt(Image.open(fp))
                except Exception:
                    pass
    return None


def get_shirt(kind, back):
    key = (kind, bool(back))
    if key not in _SHIRT_CACHE:
        _SHIRT_CACHE[key] = _user_shirt(kind, back) or make_shirt(kind, back)
    return _SHIRT_CACHE[key]


