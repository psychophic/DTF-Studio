def fmt_num(x):
    return (f"{x:.2f}".rstrip("0").rstrip(".")) or "0"


def default_sizes():
    return [dict(s) for s in DEFAULT_SIZES]


def load_sizes():
    unit, sizes = "in", []
    try:
        with open(SIZE_FILE, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        unit = "cm" if data.get("unit") == "cm" else "in"
        for s in data.get("sizes", []):
            if isinstance(s, dict) and s.get("name") and float(s.get("w", 0)) > 0 and float(s.get("h", 0)) > 0:
                sizes.append(dict(
                    name=str(s["name"]), w=float(s["w"]), h=float(s["h"]),
                    view=s.get("view") if s.get("view") in ("Front", "Back") else "Front",
                    place=s.get("place") if s.get("place") in PLACEMENTS else "Center",
                    top=float(s.get("top", 3.0)), side=float(s.get("side", 3.0)),
                    paper=s.get("paper") if s.get("paper") in PAPERS else PA3))
    except Exception:
        pass
    if not sizes:
        sizes = default_sizes()
    return unit, sizes


def save_sizes(unit, sizes):
    try:
        os.makedirs(APP_DIR, exist_ok=True)
        with open(SIZE_FILE, "w", encoding="utf-8") as fh:
            json.dump({"unit": unit, "sizes": sizes}, fh, indent=2, ensure_ascii=False)
    except OSError:
        pass


def load_source(path):
    im = ImageOps.exif_transpose(Image.open(path))
    alpha = None
    if im.mode in ("RGBA", "LA") or "transparency" in im.info:
        im = im.convert("RGBA")
        alpha = im.getchannel("A")
        if alpha.getextrema() == (255, 255):
            alpha = None
    return im.convert("RGB"), alpha


def fit_box(w, h, bw, bh):
    s = min(bw / w, bh / h)
    return max(1, round(w * s)), max(1, round(h * s))


def render_for_box(src, src_alpha, box_px, p, key, mirror=False, k=1.0):
    """Render the design so it fits inside box_px (keeps aspect ratio)."""
    w, h = src.size
    fw, fh = fit_box(w, h, box_px[0], box_px[1])
    img = render(src, src_alpha, (fw, fh), k, dict(p, mirror=False), key)
    if p.get("trim"):
        iw, ih = img.size
        nw, nh = fit_box(iw, ih, box_px[0], box_px[1])
        if (nw, nh) != (iw, ih):
            img = img.resize((nw, nh), Image.LANCZOS)
    if mirror:
        img = ImageOps.mirror(img)
    return img


def build_sheet(src, src_alpha, p, key, bw_in, bh_in, paper, dpi, mirror, margin_in=0.25):
    """Return (sheet RGB image at `dpi`, (design_w_px, design_h_px))."""
    box = (max(1, round(bw_in * dpi)), max(1, round(bh_in * dpi)))
    design = render_for_box(src, src_alpha, box, p, key, mirror=mirror, k=1.0)
    dw, dh = design.size
    m = round(margin_in * dpi)
    if paper is None:
        pw, ph, x, y = dw, dh, 0, 0
    elif paper[0] == "roll":                      # roll: fixed width, length = design + margins
        pw, ph = round(paper[1] * dpi), dh + 2 * m
        if dw > pw:
            raise ValueError("The design is wider than the roll.")
        x, y = (pw - dw) // 2, m
    else:
        pw, ph = round(paper[0] * dpi), round(paper[1] * dpi)
        if (dw > pw - 2 * m or dh > ph - 2 * m) and (dw <= ph - 2 * m and dh <= pw - 2 * m):
            pw, ph = ph, pw  # landscape sheet
        if dw > pw or dh > ph:
            raise ValueError("The design is larger than the selected paper.")
        x, y = (pw - dw) // 2, m
    sheet = Image.new("RGB", (pw, ph), (255, 255, 255))
    sheet.paste(design.convert("RGB"), (x, y), design.getchannel("A"))
    return sheet, (dw, dh)


def save_sheet(sheet, path, dpi):
    if path.lower().endswith(".png"):
        sheet.save(path, "PNG", dpi=(dpi, dpi))
    else:
        sheet.save(path, "PDF", resolution=float(dpi), quality=100, subsampling=0)


def list_printers():
    names, default = [], None
    try:
        if sys.platform.startswith("win"):
            import win32print
            for pr in win32print.EnumPrinters(2 | 4, None, 1):
                names.append(pr[2])
            default = win32print.GetDefaultPrinter()
        else:
            out = subprocess.run(["lpstat", "-e"], capture_output=True, text=True, timeout=5).stdout
            names = [ln.strip() for ln in out.splitlines() if ln.strip()]
            d = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, timeout=5).stdout
            if ":" in d:
                default = d.split(":", 1)[1].strip() or None
    except Exception:
        pass
    return names, default


def send_to_printer(sheet, dpi, printer, copies, title="DTF Halftone Studio"):
    """Print the sheet at its true physical size. Returns a status message."""
    use_default = printer in (None, "", "System default")
    pdf = os.path.join(tempfile.gettempdir(), f"dtf_print_{os.getpid()}.pdf")

    if sys.platform.startswith("win"):
        try:
            import win32print
            import win32ui
            import win32con
            from PIL import ImageWin
        except ImportError:
            win32print = None
        if win32print is not None:
            name = win32print.GetDefaultPrinter() if use_default else printer
            dc = win32ui.CreateDC()
            dc.CreatePrinterDC(name)
            try:
                dc.StartDoc(title)
                w_in, h_in = sheet.size[0] / dpi, sheet.size[1] / dpi
                for _ in range(copies):
                    dc.StartPage()
                    lx = dc.GetDeviceCaps(win32con.LOGPIXELSX)
                    ly = dc.GetDeviceCaps(win32con.LOGPIXELSY)
                    ox = dc.GetDeviceCaps(win32con.PHYSICALOFFSETX)
                    oy = dc.GetDeviceCaps(win32con.PHYSICALOFFSETY)
                    box = (-ox, -oy, -ox + int(w_in * lx), -oy + int(h_in * ly))
                    ImageWin.Dib(sheet).draw(dc.GetHandleOutput(), box)
                    dc.EndPage()
                dc.EndDoc()
            finally:
                dc.DeleteDC()
            return f"Sent to printer: {name}  ({copies} cop{'y' if copies == 1 else 'ies'})"
        # fallback without pywin32: let Windows print the PDF
        save_sheet(sheet, pdf, dpi)
        try:
            os.startfile(pdf, "print")
            return "Sent to the default printer via Windows. (Install pywin32 for direct printing.)"
        except OSError:
            os.startfile(pdf)
            return "Print file opened in your PDF viewer - press Ctrl+P there. (Install pywin32 for direct printing.)"

    save_sheet(sheet, pdf, dpi)
    cmd = ["lp"]
    if not use_default:
        cmd += ["-d", printer]
    cmd += ["-n", str(copies), "-o", "print-scaling=none", pdf]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        raise RuntimeError("The 'lp' command was not found. Use 'Save print file' instead.")
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout or "lp failed").strip())
    return f"Sent to printer: {'default' if use_default else printer}"


