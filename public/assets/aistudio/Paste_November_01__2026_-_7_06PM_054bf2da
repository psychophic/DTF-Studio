def smoothstep(x):
    x = np.clip(x, 0.0, 1.0)
    return x * x * (3.0 - 2.0 * x)


def halftone(dens, rgb, cell, angle_deg, shape, gain, min_dot, flat_color):
    """
    dens : HxW float32 (0..1)  - ink density
    rgb  : HxWx3 float32       - ink colour
    Returns (alpha HxW float32, rgb HxWx3 float32 | None)
    """
    H, W = dens.shape
    d8 = Image.fromarray((np.clip(dens, 0, 1) * 255 + 0.5).astype(np.uint8), "L")
    blur = ImageFilter.GaussianBlur(max(0.6, cell * 0.5))
    dsm = np.asarray(d8.filter(blur), dtype=np.float32) / 255.0

    rsm = None
    if flat_color:
        weighted = np.clip(rgb * dens[..., None], 0, 1)
        w8 = Image.fromarray((weighted * 255 + 0.5).astype(np.uint8), "RGB").filter(blur)
        rsm = np.asarray(w8, dtype=np.float32) / 255.0
        rsm = np.clip(rsm / np.maximum(dsm, 1e-3)[..., None], 0, 1)

    th = math.radians(angle_deg)
    c, s = math.cos(th), math.sin(th)
    out_a = np.zeros((H, W), np.float32)
    out_c = np.zeros((H, W, 3), np.float32) if flat_color else None
    xs = np.arange(W, dtype=np.float32)[None, :]
    CH = 256

    for y0 in range(0, H, CH):
        y1 = min(H, y0 + CH)
        ys = np.arange(y0, y1, dtype=np.float32)[:, None]
        u = (xs * c + ys * s) / cell
        v = (-xs * s + ys * c) / cell
        iu, iv = np.floor(u), np.floor(v)
        du, dv = u - iu - 0.5, v - iv - 0.5
        cx = ((iu + 0.5) * c - (iv + 0.5) * s) * cell
        cy = ((iu + 0.5) * s + (iv + 0.5) * c) * cell
        ix = np.clip(np.rint(cx), 0, W - 1).astype(np.int32)
        iy = np.clip(np.rint(cy), 0, H - 1).astype(np.int32)

        t = np.clip(dsm[iy, ix], 0, 1)
        t = np.power(t, 1.0 / max(gain, 0.05))

        if shape in ("Dot", "Circle"):
            r = np.hypot(du, dv)
            R = np.where(
                t <= math.pi / 4,
                np.sqrt(t / math.pi),
                0.5 + (t - math.pi / 4) / (1 - math.pi / 4) * 0.2071,
            )
        elif shape == "Diamond":
            r = np.abs(du) + np.abs(dv)
            R = np.where(t <= 0.5, np.sqrt(t / 2.0), 0.5 + (t - 0.5))
        elif shape == "Square":
            r = np.maximum(np.abs(du), np.abs(dv))
            R = 0.5 * np.sqrt(t)
        else:  # Line
            r = np.abs(dv)
            R = 0.5 * t

        cov = np.clip((R - r) * cell + 0.5, 0, 1)
        if min_dot > 0:
            cov = np.where(t < min_dot, 0.0, cov)
        out_a[y0:y1] = cov
        if flat_color:
            out_c[y0:y1] = rsm[iy, ix]

    return out_a, out_c


def render(src, src_alpha, out_size, k, p, key, fit_long=None):
    """
    src       : PIL RGB (source or proxy)
    src_alpha : PIL L or None
    out_size  : (W, H) of the image to produce
    k         : scale factor vs the final output (1.0 for export)
    p         : params dict
    key       : (r,g,b) for custom removal colour
    """
    img = src.resize(out_size, Image.LANCZOS) if src.size != out_size else src.copy()
    src_a = None
    if src_alpha is not None:
        sa = src_alpha.resize(out_size, Image.BILINEAR) if src_alpha.size != out_size else src_alpha
        src_a = np.asarray(sa, dtype=np.float32) / 255.0

    # ---- pre adjustments --------------------------------------------------
    if p["sharp"] > 0:
        img = img.filter(ImageFilter.UnsharpMask(radius=max(0.6, 1.5 * k), percent=int(p["sharp"]), threshold=2))
    if p["invert"]:
        img = ImageOps.invert(img)
    if p["gray"]:
        img = ImageOps.grayscale(img).convert("RGB")
    if abs(p["bright"] - 100) > 0.5:
        img = ImageEnhance.Brightness(img).enhance(p["bright"] / 100.0)
    if abs(p["contrast"] - 100) > 0.5:
        img = ImageEnhance.Contrast(img).enhance(p["contrast"] / 100.0)
    if abs(p["sat"] - 100) > 0.5:
        img = ImageEnhance.Color(img).enhance(p["sat"] / 100.0)

    arr = np.asarray(img, dtype=np.float32) / 255.0
    if abs(p["gamma"] - 1.0) > 1e-3:
        arr = np.power(arr, 1.0 / p["gamma"])

    # ---- key colour -------------------------------------------------------
    if p["target"] == "Black shirt":
        keyc = np.zeros(3, np.float32)
    elif p["target"] == "White shirt":
        keyc = np.ones(3, np.float32)
    else:
        keyc = np.array(key, np.float32) / 255.0

    d = np.abs(arr - keyc).max(axis=2)
    tol = p["tol"] / 100.0
    ramp = np.clip((d - tol) / max(1.0 - tol, 1e-3), 0, 1)
    dens = np.power(ramp, 1.0 / max(p["density"] / 100.0, 0.05)).astype(np.float32)

    if p["method"] == "Soft blend":
        a = dens
    else:
        a = smoothstep((d - tol) / max(p["soft"] / 100.0, 0.005)).astype(np.float32)

    if p["unmix"]:
        col = np.clip(keyc + (arr - keyc) / np.maximum(d, 1e-3)[..., None], 0, 1)
    else:
        col = arr
    is_ht = p["mode"] == "Halftone"
    hdens = None
    if is_ht:
        # tonal density: brightness (black shirt) / darkness (white shirt)
        wts = np.array([0.299, 0.587, 0.114], np.float32)
        lum = arr @ wts
        if p["target"] == "Black shirt":
            base = lum
        elif p["target"] == "White shirt":
            base = 1.0 - lum
        else:
            kl = float(keyc @ wts)
            base = np.abs(lum - kl) / max(kl, 1.0 - kl, 1e-3)
        hr = np.clip((base - tol) / max(1.0 - tol, 1e-3), 0, 1)
        hdens = np.power(hr, 1.0 / max(p["density"] / 100.0, 0.05)).astype(np.float32)
        del lum, base, hr
    del arr, d, ramp

    if p["ink"] == "White":
        col = np.ones_like(col)
    elif p["ink"] == "Black":
        col = np.zeros_like(col)

    # ---- halftone ---------------------------------------------------------
    if is_ht:
        cell = max(2.0, p["dot"] * k)
        a, hc = halftone(hdens, col, cell, p["angle"], p["shape"],
                         p["gain"] / 100.0, p["mindot"] / 100.0, p["flat"])
        if hc is not None:
            col = hc

    # ---- alpha clean-up ---------------------------------------------------
    cut, snap = p["cut"] / 100.0, p["snap"] / 100.0
    if cut > 0:
        a = np.where(a < cut, 0.0, a)
    if snap < 1:
        a = np.where(a >= snap, 1.0, a)
    if p["binary"]:
        a = (a >= 0.5).astype(np.float32)
    if src_a is not None:
        a = a * src_a

    a_img = Image.fromarray((a * 255 + 0.5).astype(np.uint8), "L")
    n = int(round(abs(p["choke"]) * k))
    if abs(p["choke"]) > 0 and n == 0:
        n = 1
    for _ in range(min(n, 40)):
        a_img = a_img.filter(ImageFilter.MaxFilter(3) if p["choke"] > 0 else ImageFilter.MinFilter(3))

    H, W = a.shape
    rgba = np.empty((H, W, 4), np.uint8)
    rgba[..., :3] = (col * 255 + 0.5).astype(np.uint8)
    rgba[..., 3] = np.asarray(a_img)
    out = Image.fromarray(rgba, "RGBA")

    if p["mirror"]:
        out = ImageOps.mirror(out)
    if p["trim"]:
        bb = out.getchannel("A").getbbox()
        if bb:
            out = out.crop(bb)
    if fit_long:
        w, h = out.size
        if max(w, h) != fit_long:
            if w >= h:
                nsz = (int(fit_long), max(1, round(h * fit_long / w)))
            else:
                nsz = (max(1, round(w * fit_long / h)), int(fit_long))
            out = out.resize(nsz, Image.LANCZOS)
    return out


def composite(rgba, bg):
    a = np.asarray(rgba, dtype=np.float32)
    h, w = a.shape[:2]
    alpha = a[..., 3:4] / 255.0
    if bg == "Checker":
        s = max(8, max(w, h) // 90)
        yy, xx = np.indices((h, w))
        m = ((yy // s + xx // s) % 2).astype(np.float32)[..., None]
        bgc = 100.0 + 40.0 * m
    elif bg == "Black":
        bgc = 0.0
    elif bg == "White":
        bgc = 255.0
    else:
        bgc = 128.0
    out = a[..., :3] * alpha + bgc * (1 - alpha)
    return Image.fromarray(np.clip(out, 0, 255).astype(np.uint8), "RGB")


def make_underbase(rgba, choke):
    a = rgba.getchannel("A").point(lambda v: 255 if v >= 10 else 0)
    for _ in range(int(choke)):
        a = a.filter(ImageFilter.MinFilter(3))
    ub = Image.new("RGB", rgba.size, (255, 255, 255))
    ub.putalpha(a)
    return ub


